# Copy to .env for local development. All values are optional; defaults are shown.

# Port the API (and the built web app) listens on
PORT=3000

# SQLite file. Use ":memory:" for an ephemeral database.
DATABASE_PATH=./data/appointments.db

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated list of allowed browser origins for the API.
# Only needed when the web app is served from a different origin than the API
# (e.g. the Vite dev server). Leave unset in production when served together.
CORS_ORIGIN=http://localhost:5173

# How far ahead customers may book, in days
BOOKING_HORIZON_DAYS=30

# Minimum notice required before a slot can be booked, in minutes
BOOKING_MIN_LEAD_MINUTES=30

# Secret used to sign customer-access, contact, and admin session tokens (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-change-me-please-32chars

# Bootstraps the FIRST staff account on a brand-new database only. Once any
# row exists in the staff_users table, these two vars are never read again --
# manage accounts from then on with:
#   npm run create-staff-user -w server -- <username> <password>
# Preferred: generate a hash and set ADMIN_PASSWORD_HASH instead of
# ADMIN_PASSWORD -- run: npm run hash-password -w server -- <password>
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=scrypt$<salt>$<hash>
ADMIN_PASSWORD=changeme123

# Failed admin logins before that account is temporarily locked, and for how long.
ADMIN_MAX_LOGIN_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15

# Emergency recovery, for when you're locked out or forgot the admin
# password and have no shell access (e.g. Render's free tier). If BOTH are
# set, that account's password is forcibly reset on every server start.
# Leave both commented out normally -- set them only to perform a reset,
# then remove them again and redeploy. See README "Recovering admin access".
# EMERGENCY_ADMIN_USERNAME=admin
# EMERGENCY_ADMIN_PASSWORD=YourNewPasswordHere12+chars

# How long a booking's personal details are kept before being anonymised (not
# deleted -- the booking's date/branch/service survive for analytics).
DATA_RETENTION_DAYS=90
# How often the retention sweep runs, in hours. 0 disables the background job.
RETENTION_CHECK_INTERVAL_HOURS=24
# How often the day-before reminder sweep runs, in minutes. 0 disables it.
REMINDER_CHECK_INTERVAL_MINUTES=60
# Contact shown on the in-app privacy notice for data-subject requests.
PRIVACY_CONTACT_EMAIL=privacy@capitec.example
