# Copy to .env for local development. All values are optional; defaults are shown.

# Port the API (and the built web app) listens on
PORT=3000

# SQLite file. Use ":memory:" for an ephemeral database.
DATABASE_PATH=./data/appointments.db

# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Comma-separated list of allowed browser origins for the API.
# Only needed when the web app is served from a different origin than the API
# (e.g. the Vite dev server). Leave unset in production when served together.
CORS_ORIGIN=http://localhost:5173

# How far ahead customers may book, in days
BOOKING_HORIZON_DAYS=30

# Minimum notice required before a slot can be booked, in minutes
BOOKING_MIN_LEAD_MINUTES=30

# Secret used to sign customer-access and admin session tokens (HMAC-SHA256).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-change-me-please-32chars

# Staff credentials for the /admin analytics dashboard. Change these in any
# real deployment -- they are plaintext defaults meant only for local use.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
