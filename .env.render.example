# ── Render deployment environment variables ─────────────────────────────────
# Don't commit this file with real secrets filled in. On Render, add these
# one by one under: your service → Environment → Environment Variables.
# This file is just a convenient reference of what to add.

# --- Required ---

NODE_ENV=production

# Do NOT set PORT yourself -- Render injects it automatically and the app
# already reads process.env.PORT. Setting it manually can break routing.

# Serves the built React app from the same service as the API (single
# Render web service, not two). Must match where `npm run build` outputs
# the client, relative to the repo root.
STATIC_DIR=client/dist

# SQLite file path. Render's filesystem is EPHEMERAL by default -- anything
# written here is wiped on every deploy and on most restarts. To actually
# keep bookings between deploys:
#   1. Render dashboard -> your service -> Disks -> Add Disk
#   2. Mount path: /var/data   (size: 1 GB is plenty for this app)
#   3. Set DATABASE_PATH to a file inside that mount, as below.
# If you skip this, the app still works, but the database resets on every deploy.
DATABASE_PATH=/var/data/appointments.db

# Signs customer-access, contact, and admin tokens. Generate a real random
# value -- do not reuse this example one. Run locally:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=97c98111521bcc9a4d642fd4639f431807fe1de6ab8c056f8cfdc62372940cd0

# Staff sign-in for /admin. Generate a hash for your own password locally
# (never put the plaintext password in an env var) by running, from the
# repo root, after `npm install`:
#   npm run hash-password -w server -- "YourStrongPasswordHere"
# then paste the printed value (starts with "scrypt$...") below.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt$REPLACE_ME_RUN_THE_COMMAND_ABOVE

# --- Optional (defaults shown; only add if you want to change them) ---

# LOG_LEVEL=info
# BOOKING_HORIZON_DAYS=30
# BOOKING_MIN_LEAD_MINUTES=30
# DATA_RETENTION_DAYS=90
# RETENTION_CHECK_INTERVAL_HOURS=24
# REMINDER_CHECK_INTERVAL_MINUTES=60
# PRIVACY_CONTACT_EMAIL=privacy@yourdomain.example

# Only needed if the frontend is hosted separately from this API (it isn't,
# in the default single-service setup -- leave unset).
# CORS_ORIGIN=https://your-frontend.example
